# Use Node.js 20 LTS with newer glibc for linux-x64-gnu native modules.
# Node 20 exposes the global Web Crypto API (globalThis.crypto), which jose 6.x
# requires; Node 18 does not and is EOL.
FROM node:20-bookworm-slim

# Set working directory
WORKDIR /app

# Install build dependencies for native modules and RocksDB
RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    python3 make g++ \
    libsnappy-dev zlib1g-dev libbz2-dev liblz4-dev libzstd-dev \
  && rm -rf /var/lib/apt/lists/*

# Copy the entire monorepo (node_modules and all)
COPY . .

# Build against the copied workspace node_modules, like Dockerfile.datastream. No separate
# install: the root `npm ci` already hoists @aws-sdk/client-s3, and an `npm install
# --no-workspaces` here would try to fetch the workspace-only @nihilium/core and
# @nihilium/registry from npmjs.org (404). packages/registry must be built (dist/ + out/*.json)
# before this image: the processor imports it.
RUN cd apps/processor && npm run build

# Expose the port (default is 3006 based on server.ts)
EXPOSE 3006

# Set working directory to the processor app
WORKDIR /app/apps/processor

# Create a non-root user for security
RUN groupadd -g 1001 nodejs \
  && useradd -u 1001 -g nodejs -m -s /bin/bash processor

# Evidence store directories (3/3 local quorum example; use e0..e4 for 3/5)
RUN mkdir -p /data/e0 /data/e1 /data/e2 /data/e3 /data/e4 \
  && chmod 700 /data/e0 /data/e1 /data/e2 /data/e3 /data/e4

# Ensure the processor user has write permissions for runtime-generated files
RUN chown -R processor:nodejs /app/apps/processor \
  && chown -R processor:nodejs /app/packages \
  && chown -R processor:nodejs /data

USER processor

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:3006/health || exit 1

# Start the application
CMD ["npm", "start"] 
# Use Node.js 18 LTS with newer glibc for linux-x64-gnu native modules
FROM node:18-bookworm-slim

# Set working directory
WORKDIR /app

# Install build dependencies for native modules and RocksDB
RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    python3 make g++ \
    libsnappy-dev zlib1g-dev libbz2-dev liblz4-dev libzstd-dev \
  && rm -rf /var/lib/apt/lists/*

# Copy the entire monorepo (node_modules and all)
COPY . .

# Install processor-only deps (workspace npm may not hoist @aws-sdk) and build
# Remove local ethers after --no-workspaces install to avoid duplicate type identities with root
RUN cd apps/processor \
  && npm install @aws-sdk/client-s3@3.758.0 --no-workspaces \
  && rm -rf node_modules/ethers \
  && npm run build

# Expose the port (default is 3006 based on server.ts)
EXPOSE 3006

# Set working directory to the processor app
WORKDIR /app/apps/processor

# Create a non-root user for security
RUN groupadd -g 1001 nodejs \
  && useradd -u 1001 -g nodejs -m -s /bin/bash processor

# Evidence store directories (3/3 local quorum example; use e0..e4 for 3/5)
RUN mkdir -p /data/e0 /data/e1 /data/e2 /data/e3 /data/e4 \
  && chmod 700 /data/e0 /data/e1 /data/e2 /data/e3 /data/e4

# Ensure the processor user has write permissions for runtime-generated files
RUN chown -R processor:nodejs /app/apps/processor \
  && chown -R processor:nodejs /app/packages/privacy-lib/dist/lib/processor \
  && chown -R processor:nodejs /data

USER processor

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:3006/health || exit 1

# Start the application
CMD ["npm", "start"] 
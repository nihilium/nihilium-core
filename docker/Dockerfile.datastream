# Use Node.js 18 LTS as base image
FROM node:18-alpine

# Set working directory
WORKDIR /app

# Install build dependencies for native modules and RocksDB
RUN apk add --no-cache python3 make g++ snappy-dev zlib-dev bzip2-dev lz4-dev zstd-dev

# Copy the entire monorepo (node_modules and all)
COPY . .

# Build the datastream application
RUN cd apps/datastream-server && npm run build

# Expose the port (default is 3006 based on server.ts)
EXPOSE 3006

# Set working directory to the datastream app
WORKDIR /app/apps/datastream-server

# Create a non-root user for security
RUN addgroup -g 1001 -S nodejs
RUN adduser -S datastream -u 1001

# Create the server-stream directory and set proper permissions
RUN mkdir -p ./server-stream && chown -R datastream:nodejs ./server-stream

USER datastream

# Health check (using the /address endpoint since there's no /health endpoint)
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:3006/health || exit 1

# Start the application
CMD ["npm", "start"] 
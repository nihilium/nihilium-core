{
  "name": "@nihilium/registry",
  "version": "1.0.0",
  "description": "On-chain registries for Nihilium protocol processors, datastreams and condition verifiers",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "artifacts",
    "typechain-types"
  ],
  "scripts": {
    "build": "npm run build:sol && npm run build:ts",
    "build:sol": "forge build",
    "build:ts": "tsc -p tsconfig.lib.json",
    "build:watch": "tsc -p tsconfig.lib.json --watch",
    "test": "jest",
    "clean": "rm -rf out cache_forge dist",
    "deploy-anvil": "DEPLOY_NETWORK=anvil PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80 forge script",
    "deploy-avax-testnet": "DEPLOY_NETWORK=avax-testnet forge script",
    "deploy": "dotenv -e .env -- sh -c 'forge script script/Deploy.s.sol:DeployScript --rpc-url \"$RPC_URL\" --broadcast'"
  },
  "dependencies": {
    "@nihilium/core": "*",
    "@noble/curves": "^1.5.0",
    "@noble/hashes": "^1.3.3",
    "@openzeppelin/contracts": "^5.2.0",
    "dotenv": "^16.4.7",
    "ethers": "^6.14.0",
    "poseidon2-evm": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.17.6",
    "dotenv-cli": "^11.0.0",
    "typescript": "^5.3.3"
  }
}

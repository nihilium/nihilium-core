{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "declaration": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "typeRoots": ["./node_modules/@types", "./src/types/**/*"]
  },
  "include": ["./src/**/*", "./typechain-types/**/*"],
  "exclude": ["node_modules", "test", "**/*.test.ts"]
  
} 
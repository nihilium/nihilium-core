{
  "name": "@nihilium/client-sdk",
  "version": "0.4.0",
  "description": "Browser SDK for privacy-accounts, using privacy-lib.",
  "type": "module",
  "main": "dist/index.mjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.mjs"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "default": "./dist/types.mjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "publish-script": "npm run build && npm publish --access public",
    "build": "npm run build:js && npm run build:types",
    "build:js": "NODE_OPTIONS='--max-old-space-size=18192' vite build --config vite.config.mjs",
    "build:types": "NODE_OPTIONS='--max-old-space-size=18192' rollup -c rollup.dts.config.mjs",
    "clean": "rm -rf dist",
    "dev": "vite build --config vite.config.mjs --watch"
  },
  "dependencies": {
    "poseidon-lite": "^0.3.0"
  },
  "devDependencies": {
    "@nihilium/core": "*",
    "@nihilium/zkp-circuits": "*",
    "axios": "^1.10.0",
    "typescript": "^5.3.3"
  }
}

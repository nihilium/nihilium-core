{
  "compilerOptions": {
    "target": "ES2020",
      "module": "ES2020",
      "moduleResolution": "node",
      "outDir": "./dist/browser",
      "rootDir": "./src",
      "strict": true,
      "esModuleInterop": true,
      "skipLibCheck": true,
      "forceConsistentCasingInFileNames": true,
      "resolveJsonModule": true
  },
  "include": [
    "./src/index.browser.ts",
    "./src/types/**/*",
    "./src/lib/reveal_methods/**/*",
   "./src/lib/client_single_share_sealing.ts",
   "./src/lib/client_single_share_unsealing.ts",
   "./src/lib/data_stream/DataStreamClient.ts",
   
   
   
  ],
  "exclude": ["node_modules", "test", "**/*.test.ts",
      "./src/lib/persistence/**/*",
      "./src/lib/contract_wrappers/**/*",
      "./src/lib/processor.ts",
      "./src/lib/data_stream/EVMDataStream.ts"
]
  
} 
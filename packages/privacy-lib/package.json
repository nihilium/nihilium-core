{
  "name": "@nihilium/privacy-lib",
  "version": "1.0.0",
  "description": "TypeScript library for privacy-preserving computations using Circom",
  "main": "dist/index.js",
  "module": "dist/browser/index.browser.mjs",
  "browser": "dist/browser/index.browser.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "browser": "./dist/browser/index.browser.mjs",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "build": "hardhat compile && tsc && vite build",
    "test": "jest",
    "deploy-static-ganache": "DEPLOY_NETWORK=ganache PRIVATE_KEY=0x00c02c2c80ec46a6cbc5ccce6b0ce9e293c46a568cd2ffdfb69315efd7dafa36 npx hardhat run scripts/deploy_static.ts",
    "deploy-static-avax-testnet": "DEPLOY_NETWORK=avax-testnet npx hardhat run scripts/deploy_static.ts",
    "test-circuits": "ts-mocha --timeout 5000000 ./test/full.test.ts --exit",
    "copy-circuits": "rm -rf ./circuits && mkdir circuits && cp -rf ../circom/build/encrypt_proof ./circuits/encrypt_proof && cp -rf ../circom/build/validated_sig_he_add ./circuits/validated_sig_he_add && cp -rf ../circom/build/severed_commitment ./circuits/severed_commitment",
    "test:watch": "jest --watch",
    "build-browser": "vite build",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "keywords": [
    "privacy",
    "circom",
    "zero-knowledge",
    "zkp",
    "wasm"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@ethereumjs/block": "^10.0.0",
    "@ethereumjs/common": "^10.0.0",
    "@ethereumjs/tx": "^10.0.0",
    "@ethereumjs/util": "^10.0.0",
    "@ethereumjs/vm": "^10.0.0",
    "@nihilium/circom-circuits": "*",
    "@nihilium/zkp-circuits": "*",
    "@noble/curves": "^1.2.0",
    "@noble/hashes": "^1.3.3",
    "@openzeppelin/contracts": "^5.2.0",
    "@zk-kit/eddsa-poseidon": "^1.1.0",
    "@zk-kit/utils": "^1.4.1",
    "axios": "^1.9.0",
    "buffer": "^6.0.3",
    "circomlibjs": "^0.1.7",
    "dotenv": "^16.5.0",
    "ethers": "^6.14.0",
    "fixed-merkle-tree": "0.7.3",
    "level": "^10.0.0",
    "mocha-suppress-logs": "^0.3.1",
    "poseidon-lite": "^0.3.0",
    "rollup-plugin-node-polyfills": "^0.2.1",
    "snarkjs": "^0.7.0",
    "vite-plugin-node-polyfills": "^0.24.0",
    "@coral-xyz/anchor": "^0.31.1",
    "@solana/web3.js": "^1.95.2",
    "@solana/spl-token": "^0.4.8",
    "bn.js": "^5.2.1"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "^3.0.8",
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@types/chai": "^4.3.20",
    "@types/chai-as-promised": "^7.1.5",
    "@types/jest": "^29.5.11",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.17.6",
    "chai": "^4.3.10",
    "chai-as-promised": "^7.1.1",
    "hardhat": "^2.24.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "ts-mocha": "^11.1.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.3.3"
  },
  "peerDependencies": {
    "circomlibjs": "^0.1.7"
  },
  "resolutions": {
    "ethers": "^6.14.0"
  }
}

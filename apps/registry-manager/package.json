{
  "name": "@nihilium/registry-manager",
  "version": "1.0.0",
  "description": "CLI for managing Nihilium processor and datastream registry entries",
  "license": "Apache-2.0",
  "main": "dist/cli.js",
  "bin": {
    "nihilium-registry": "dist/cli.js",

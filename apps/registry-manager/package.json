    "@types/yargs": "^17.0.32",
    "chalk": "^4.1.2",
    "cli-table3": "^0.6.5",
    "dotenv": "^16.4.5",
    "esbuild": "^0.25.6",
    "ethers": "^6.14.0",
    "inquirer": "^8.2.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "yargs": "^17.7.2"

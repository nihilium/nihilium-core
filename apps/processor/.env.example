# =============================================================================
# Server
# =============================================================================
PORT=3006
NODE_ENV=development

# =============================================================================
# Network (shared across all Nihilium apps)
# =============================================================================
RPC_URL=
CHAIN_ID=43113

# =============================================================================
# Processor keys (same names as registry-manager)
# =============================================================================

# Ethereum private key used to sign on-chain transactions for the processor.
PROCESSOR_PRIVATE_KEY=

# Baby Jubjub private key(s) for EdDSA signing.
# Comma-separated if you have more than one; the node uses the first entry.
# Each key must be a valid BJJ subgroup scalar: 1 <= key < subgroup ORDER.
PROCESSOR_SIGNING_PRIVATE_KEYS=

# Baby Jubjub private key(s) for Homomorphic Encryption (ECElGamal).
# Comma-separated if you have more than one; the node uses the first entry.
# Each key must be a valid BJJ subgroup scalar: 1 <= key < subgroup ORDER.
PROCESSOR_HE_PRIVATE_KEYS=

# =============================================================================
# Payment verification (optional)
# =============================================================================
# NIHILIUM_JWKS_URL=https://api.nihilium.io/.well-known/jwks.json
# NIHILIUM_JWT_ISSUER=https://api.nihilium.io

# =============================================================================
# Evidence store (defaults: 1/1 at data/evidence if unset)
# =============================================================================

# Local development (3/5 with five writable dirs under apps/processor/data/)
# EVIDENCE_QUORUM=3/5
# EVIDENCE_BACKENDS=[{"type":"local","path":"data/e0","id":"e0"},{"type":"local","path":"data/e1","id":"e1"},{"type":"local","path":"data/e2","id":"e2"},{"type":"local","path":"data/e3","id":"e3"},{"type":"local","path":"data/e4","id":"e4"}]

# Docker (paths under mounted volume /data)
# EVIDENCE_QUORUM=3/3
# EVIDENCE_BACKENDS=[{"type":"local","path":"/data/e0","id":"e0"},{"type":"local","path":"/data/e1","id":"e1"},{"type":"local","path":"/data/e2","id":"e2"}]

# Production mix (local + S3) — requires AWS_* credentials for s3 backends
# EVIDENCE_QUORUM=3/5
# EVIDENCE_BACKENDS=[{"type":"local","path":"/data/e0"},{"type":"local","path":"/data/e1"},{"type":"s3","bucket":"...","region":"eu-west-1","prefix":"evidence/"},{"type":"s3","bucket":"...","region":"us-east-1"},{"type":"local","path":"/data/e4"}]

# EVIDENCE_ENCRYPTION_KEY=64_hex_characters_32_bytes
# EVIDENCE_HEALTH_STRICT=false

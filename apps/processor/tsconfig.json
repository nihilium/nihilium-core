{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "paths": {
      "@nihilium/core/src/*": ["../../packages/privacy-lib/src/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules"]
} 